{
  "name": "dsh-embedded-browser",
  "version": "0.3.0",
  "description": "A browser that lives inside the DSH host: every session gets its own tab, the AI drives it with lazily published browser_embedded_* tools, and a human watches or takes over that same tab in an on-demand right-Sidebar tab — no GUI, no external browser, logins/2FA/QR codes/CAPTCHAs included.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/lazy-gate.mjs && node test/smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "browser",
    "embedded-browser",
    "headless-browser",
    "lazy-tools",
    "cdp",
    "chrome-devtools-protocol",
    "agent-tools",
    "human-in-the-loop"
  ],
  "author": "roc <i@roc.im>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imroc/dsh-embedded-browser.git"
  },
  "homepage": "https://github.com/imroc/dsh-embedded-browser#readme",
  "bugs": {
    "url": "https://github.com/imroc/dsh-embedded-browser/issues"
  }
}